{
  "manifest_version": 3,
  "name": "ImmoScout24 Tool: €/m² Preis-Badge & Quadratmeterpreis",
  "version": "1.0.1",
  "description": "ImmoScout24-Tool: zeigt den Preis pro m² (€/m²) als farbiges Badge in den Suchergebnissen – Immobilien schneller vergleichen.",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png",
    "256": "icon-256.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.immobilienscout24.de/*"],
      "js": ["content-script.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
